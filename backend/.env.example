# Copy to backend/.env (gitignored) and fill in, for a local run. Variables
# already set in the environment take precedence over this file.
#
# On Posit Connect, set these under the content's Vars instead, and keep the
# file out of the bundle: deploy with --exclude .env (see README.md).

# CARTO basemap key for Positron / Dark Matter, used by the map in the browser
# and by the map export. Without it the tiles are requested unkeyed.
CARTO_API_KEY=
